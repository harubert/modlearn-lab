# Vorlage für .env. Die echte Datei wird nie eingecheckt.
#
# Diese Vorlage ist vollständig: Jede Einstellung, die config/settings.py aus
# der Umgebung liest, steht hier. Das ist beim Umzug auf einen anderen Server
# der ganze Punkt – wer eine Zeile vergisst, merkt es nicht an einem Fehler,
# sondern daran, dass eine Betriebsart still verschwunden ist. Fehlt etwa
# SPARK_AUDIO_BASE_URL, dann ist der Mikrofonknopf einfach weg und niemand
# sucht in der Umgebung danach.
#
# Zwei Dateien gehören NICHT hierher und müssen beim Umzug von Hand mit:
#   .env                        – diese Werte, echt ausgefüllt
#   ../.env.cloud               – der Schlüssel für die Qualitätssicherung
#                                 (Modus 600, außerhalb des Git-Baums)

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=hier-einen-langen-zufallswert-einsetzen
DJANGO_DEBUG=0
# Beim Domänenwechsel sind das die zwei Zeilen, die zählen. Ohne sie
# antwortet Django mit „Bad Request (400)", und zwar ohne weitere Erklärung.
DJANGO_ALLOWED_HOSTS=lab.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://lab.example.org
DJANGO_LOG_LEVEL=INFO
# Nur abschalten, solange noch kein Zertifikat steht: Ohne TLS davor leitet
# Django sonst endlos auf https um. Voreinstellung ist „an", wenn DEBUG aus ist.
DJANGO_SECURE_SSL_REDIRECT=1

# --- Veröffentlichung -----------------------------------------------------
# Am Server 8090, lokal darf es 8000 sein.
APP_PORT=8090
UVICORN_WORKERS=2

# --- Datenbank ------------------------------------------------------------
POSTGRES_DB=modlearn
POSTGRES_USER=modlearn
POSTGRES_PASSWORD=hier-ein-eigenes-kennwort
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Zugang der Lehrperson ------------------------------------------------
# Ohne Kennwort wird kein Zugang angelegt, dann kann sich niemand anmelden.
# Achtung: lehrperson_anlegen setzt is_superuser bei JEDEM Start auf False.
# Verwaltungsrechte gehören auf ein eigenes Konto, siehe plan_zugang.
TEACHER_USERNAME=lehrperson
TEACHER_PASSWORD=

# --- Sprachmodell auf dem Spark -------------------------------------------
# Kein Zugangsschlüssel, der Schutz ist das Tailnet. Die Adresse ist eine
# Tailscale-Adresse und hängt am Spark, nicht am Anwendungsserver: Sie bleibt
# beim Umzug dieselbe, sobald der neue Server dem Tailnet beigetreten ist.
SPARK_BASE_URL=http://127.0.0.1:8000/v1
SPARK_MODEL=qwen3-vl-30b
SPARK_TIMEOUT_SECONDS=60
SPARK_RETRIES=1

# --- Spracherkennung am Spark ---------------------------------------------
# Fehlt die Adresse, ist der Mikrofonknopf sichtbar abgeschaltet statt kaputt.
# Das ist kein Fehlerfall, deshalb fällt das Fehlen auch nicht auf.
SPARK_AUDIO_BASE_URL=http://127.0.0.1:8002/v1
SPARK_AUDIO_MODEL=whisper-large-v3
SPARK_AUDIO_TIMEOUT_SECONDS=60

# --- Wie viele Plätze hat der Spark? --------------------------------------
# Eine Schätzung aus dem Lasttest, keine Erkenntnis. /plan/rueckblick/ stellt
# sie neben die gemessene Spitze; die Zahl gehört korrigiert, sobald die Seite
# etwas anderes sagt.
SPARK_PLAETZE=120
# Welche Modelle ohne Umbau gleichzeitig im Speicher liegen. Beobachtet, nicht
# zugesagt: "text" (qwen3-vl-30b, Port 8000) und "gehoer" (whisper-large-v3,
# Port 8002). Was hier nicht steht, macht eine Buchung alleinig - das ist die
# vorsichtige Richtung. Schlüssel siehe plan/konzepte.py.
SPARK_GELADENE_MODELLE=text,gehoer

# --- Anmeldung über die PH (Microsoft Entra, über login.ph-vorarlberg.at) --
# Caddy prüft die Anmeldung und reicht die Person als X-Auth-Kopfzeilen durch,
# zusammen mit einem Geheimnis, das nur Caddy und dieser Container kennen.
# Die Datei liegt ausserhalb des Git-Baums und wird nur lesend eingebunden.
PH_PROXY_SECRET_DATEI=/run/geheim/lab-proxy

# --- Zuschaltbare Cloud-Hilfe, in der Oberfläche „Qualitätssicherung" -----
# Ohne Schlüssel bleibt der Schalter sichtbar, sendet aber nichts (Trockenlauf).
# CLOUD_API_KEY steht in der Produktion NICHT hier, sondern in .env.cloud.
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=
CLOUD_API_KEY=
CLOUD_PROVIDER=openai
# Eigene Frist: Der Weg nach draußen hat andere Zeiten als das eigene Netz.
CLOUD_TIMEOUT_SECONDS=45

# --- Protokollstufe (CLAUDE.md 3b), seit 1.11.2026 fest am Server ------------
# 1 nur Zahlen, 2 maskierte Texte, 3 Originaltexte (Vorgabe; für die
# Forschung vor der Auswertung anonymisiert). PROTOKOLLSTUFE_WAEHLBAR=1 holt
# die Auswahl ins Lehrpersonen-Formular zurück.
PROTOKOLLSTUFE=3
PROTOKOLLSTUFE_WAEHLBAR=0

# --- Preise und Budgetwächter ---------------------------------------------
# Preise in Euro je einer Million Token, getrennt nach Ein- und Ausgang.
# Bewusst aus der Umgebung: Preise ändern sich, der Code nicht.
CLOUD_PREISE={"gpt-5": {"ein": 1.07, "aus": 8.55}}
# Harte Obergrenzen. Erreicht heißt: der Weg nach draußen ist gesperrt, und
# das steht sichtbar da, statt still weiter Geld auszugeben.
BUDGET_JE_SITZUNG_EURO=1.00
BUDGET_JE_TAG_EURO=3.00
# Zusätzlich eine Zählung der Aufrufe. Sie wirkt auch ohne hinterlegte Preise –
# und das ist der Normalfall. Ein Wächter, der nur bei bekannten Preisen
# greift, ist bei unbekannten Preisen gar keiner.
CLOUD_AUFRUFE_JE_SITZUNG=60
CLOUD_AUFRUFE_JE_TAG=300

# --- Der Modell-Broker am Spark (Port 8010, nur Tailnet) -------------------
# Die eine Stelle, die weiss, was im Speicher liegt. SPARK_PROFIL und
# SPARK_GELADENE_MODELLE oben sind nur die Rueckfallebene ohne Broker.
SPARK_BROKER_URL=http://127.0.0.1:8010
SPARK_BROKER_SECRET_DATEI=/run/geheim/spark-broker
# Profil, mit dem die App rechnet, solange der Broker nichts sagt.
SPARK_PROFIL=qwen

# --- Der Musikdienst am Spark (Port 8011, nur Tailnet) ---------------------
# Testecke unter /labor/musik/. Dasselbe Geheimnis wie der Broker oben.
MUSIK_URL=http://127.0.0.1:8011

# --- Der Pfoertner (Fachgrenze, 7.11.2026) ---------------------------------
# Leer: das Modell am Spark urteilt selbst, ob ein Beitrag zur Stunde gehoert.
# Mit einem zweiten Modell (OpenAI-Schnittstelle, z. B. Ministral 3 am Spark):
# PFOERTNER_BASE_URL=http://127.0.0.1:8004/v1
# PFOERTNER_MODEL=ministral-3-8b
PFOERTNER_BASE_URL=
PFOERTNER_MODEL=
PFOERTNER_TIMEOUT_SECONDS=20

# --- Sprachausgabe am Spark (Port 8003, nur Tailnet; ablage/spark-tts) -----
# Leer: der Browser liest mit seiner eigenen Stimme. Mit Adresse spricht
# Qwen3-TTS am Spark (Stimme Ryan). SPARK_TTS_ATTRAPPE=1 nur am
# Entwicklungs-PC: Tonfolge statt Sprache, ohne Netz.
# SPARK_TTS_BASE_URL=http://127.0.0.1:8003/v1
SPARK_TTS_BASE_URL=
SPARK_TTS_MODEL=qwen3-tts-1.7b
SPARK_TTS_STIMME=Ryan
SPARK_TTS_TIMEOUT_SECONDS=60
SPARK_TTS_ATTRAPPE=

# --- Der Modellwaechter (12.11.2026; modellwaechter/README.md) --------------
# Fragt einmal am Tag die Register nach neuen Modellen (manage.py
# modelle_pruefen per systemd-Timer am Server). Leer lassen heisst Vorgabe.
# Hersteller bei Hugging Face, mit Komma; Vorgabe aus dem Modellmarkt 7.11.
MODELLWAECHTER_HF_AUTOREN=
MODELLWAECHTER_GITHUB_REPOS=vllm-project/vllm
MODELLWAECHTER_OPENROUTER=1
# Fragt mit CLOUD_API_KEY das eigene Konto nach den nutzbaren Modellen.
MODELLWAECHTER_OPENAI_KONTO=1
MODELLWAECHTER_TIMEOUT_SECONDS=30
MODELLWAECHTER_EINORDNUNGEN_JE_LAUF=10
# Empfaenger der Meldung, mit Komma. Ohne Mailserver unten nur die Seite.
MODELLWAECHTER_EMPFAENGER=

# --- E-Mail (offen: Relay der PH eintragen) -------------------------------
# Ohne EMAIL_HOST wird nichts verschickt.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
